{
  "name": "baileys-server",
  "version": "1.0.0",
  "description": "",
  "main": "crm/backend/api/server.js",
  "scripts": {
    "start": "node crm/backend/api/server.js",
    "dev": "concurrently \"node crm/backend/tools/runWhenPortFree.js 4000 cross-env NGROK_MANAGED_EXTERNALLY=true node crm/backend/api/server.js\" \"node crm/backend/tools/runWhenPortFree.js 8080 npm --prefix crm/frontend run dev\"",
    "dev:backend": "node crm/backend/tools/runWhenPortFree.js 4000 cross-env NGROK_MANAGED_EXTERNALLY=true node crm/backend/api/server.js",
    "test": "jest --runInBand --config crm/backend/tests/jest.config.js",
    "start:api": "node crm/backend/api/api.js",
    "start:agent": "node crm/backend/api/localRuntimeAgent.js",
    "test:ai": "node crm/backend/tests/testRunner.js",
    "test:ai:watch": "node crm/backend/tests/testRunner.js --watch",
    "test:stabilization": "node crm/backend/crm/tests/stabilizationSmokeTest.js",
    "test:stabilization:4010": "set BASE_URL=http://localhost:4010&& node crm/backend/crm/tests/stabilizationSmokeTest.js",
    "test:stabilization:ci": "node crm/backend/crm/tests/stabilizationSmokeTest.js --ci",
    "inspect:ai": "node crm/backend/crm/services/aiInspector/index.js",
    "docs:generate": "node crm/backend/crm/docs/generateArchitectureDoc.js",
    "tasks:generate": "node crm/backend/tools/taskGenerator.js",
    "frontend:dev": "npm --prefix crm/frontend run dev",
    "frontend:build": "npm --prefix crm/frontend run build",
    "frontend:preview": "npm --prefix crm/frontend run preview",
    "engine:safe": "node crm/backend/tools/engineControl.js safe-status",
    "engine:analyze": "node crm/backend/tools/engineControl.js analyze",
    "engine:validate": "node crm/backend/tools/engineControl.js validate",
    "engine:monitor": "node crm/backend/tools/engineControl.js monitor",
    "engine:commit-msg": "node crm/backend/tools/engineControl.js commit-msg",
    "engine:pull-source": "git -C C:/projetos/ai-whatsapp-saas/ai-engine pull --ff-only"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "axios": "^1.13.6",
    "body-parser": "^2.2.2",
    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "docx": "^9.6.1",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "node-cron": "^4.2.1",
    "node-notifier": "^10.0.1",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.3.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  }
}
