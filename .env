# ZapAI CRM — Backend Environment Variables

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000

# ─── Frontend CORS ───────────────────────────────────────────────────────────
# Additional frontend origin to whitelist (beyond the defaults).
# Local dev origins (localhost:8080 and localhost:5173) are always allowed.
# Set this on VPS: FRONTEND_URL=https://app.yourdomain.com
FRONTEND_URL=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=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

# ─── PostgreSQL (optional) ───────────────────────────────────────────────────
# Leave empty to use in-memory storage.
DATABASE_URL=

# ─── Default company ─────────────────────────────────────────────────────────
DEFAULT_COMPANY_ID=default

# ─── AI Engine Control Layer ────────────────────────────────────────────────
# Local cloned engine command used by npm run engine:analyze
AI_ENGINE_CMD=node C:/projetos/ai-whatsapp-saas/ai-engine/cli/index.js analyze .
# Continuous monitor interval (ms)
ENGINE_MONITOR_INTERVAL_MS=30000

FENIX_AI_DEFAULT_PROVIDER=openai
FENIX_AI_DEFAULT_MODEL=gpt-4o-mini
