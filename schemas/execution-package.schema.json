{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FÊNIX Execution Package Schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "enum": ["fenix.execution-package.v1"]
    },
    "mission": {
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "state": { "type": "string" }
      },
      "required": ["id", "title", "state"]
    },
    "goal": {
      "type": "string"
    },
    "allowedFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "checks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "object"
    },
    "expectedOutput": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["patch"] }
      },
      "required": ["type"]
    }
  },
  "required": [
    "schema",
    "mission",
    "goal",
    "allowedFiles",
    "checks",
    "constraints",
    "expectedOutput"
  ]
}
