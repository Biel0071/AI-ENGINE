  "spatialArchitecture": {
    "philosophy": "TOKEN != DESIGN: Eliminating the SaaS KPI Dashboard antipattern in favor of dense, operational Cockpits, Consoles, and 4-Quadrant Workspaces.",
    "patterns": {
      "CockpitWorkspace": {
        "target": "view-command",
        "panes": [
          "Left: Canonical System Navigation Rail",
          "Center: Current Mission Workspace (Hero Stage, Stepper Timeline, System Pulse, Operational Stream)",
          "Right: Dedicated Context Inspector (Mission, Agent, Host, Memory)"
        ]
      },
      "WorkforceLivingConsole": {
        "target": "view-agents",
        "panes": [
          "Top: Living Pulse Strip (Status, Capacity Ratio, Zero-Mock Counters)",
          "Left: Squad Groups (Active Squad, Available Squad, Supervised Squad)",
          "Right: Docked Agent Deep Inspector (Identity, Specialty, Capabilities, Memory, Direct Controls)"
        ]
      },
      "DeveloperIdeQuad": {
        "target": "view-ide",
        "panes": [
          "Quadrant 1 (Left): Project Explorer Tree & Workspace Navigator",
          "Quadrant 2 (Center-Top): Multi-tab Code Editor with Syntax Highlighting & AST status",
          "Quadrant 3 (Center-Right): Dark Live Preview Canvas with responsive viewport toggles",
          "Quadrant 4 (Bottom): Docked Operations Tray (Terminal, Output, Diagnostics, Git Status)"
        ]
      },
      "LivingAgentOfficeWorkspace": {
        "target": "view-city (office mode)",
        "panes": [
          "Top: Living Office Pulse Strip (#officeHudTotalOffices, #officeHudActiveAgents, #officeHudInMeeting, #officeHudOpenConversations)",
          "Center: Spatial Floorplan Grid (20 Desks in 4 Suites, 4 Collective Rooms: Alfa, Review, Lounge, War Room)",
          "Right/Dock: Collaboration & Dialogue Drawer (#officeDockBody)",
          "Modals: Door Knock, Multi-Agent Meeting, Emergency War Room"
        ]
      }
    }
  },
