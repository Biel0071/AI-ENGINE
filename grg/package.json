{
  "name": "grg-services-os",
  "version": "1.0.0",
  "private": true,
  "description": "GRG Services OS — AI-native software engineering operating system (local-first core).",
  "type": "commonjs",
  "bin": {
    "fenix": "./bin/fenix.js",
    "fenix-mcp": "./bin/fenix-mcp.js"
  },
  "main": "src/app.js",
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "test": "node --test --test-force-exit --test-reporter=dot \"test/*.test.js\"",
    "test:orchestration": "node --test test/central-orchestrator.test.js test/job-engine.test.js test/safe-development-pipeline.test.js test/aiplatform.test.js test/aiplatform-job-polling.test.js",
    "qa:screen-map": "node scripts/build-screen-function-map.js",
    "qa:screen-plan": "node scripts/generate-screen-qa-plan.js",
    "qa:screen-readiness": "node scripts/build-screen-readiness-report.js",
    "qa:screen-queue": "node scripts/build-screen-improvement-queue.js",
    "qa:screen-contracts": "node scripts/probe-screen-contracts.js",
    "qa:frontend": "node scripts/frontend-navigation-qa.js",
    "qa:frontend:fast": "node scripts/frontend-navigation-qa.js --fast",
    "qa:frontend:all": "node scripts/run-frontend-audit.js",
    "qa:playwright": "node qa/fenix-city-playwright.mjs",
    "build:windows-agent": "node scripts/build-windows-agent.js",
    "mcp": "node bin/fenix-mcp.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1091.0",
    "bullmq": "5.81.2",
    "jose": "6.2.3",
    "pg": "8.22.0",
    "redis": "6.1.0",
    "sqlite3": "^5.1.7",
    "ws": "^8.21.1",
    "playwright": "^1.40.0"
  }
}
