{
  "version": 1,
  "domains": {
    "command": ["city", "agents", "operations"],
    "build": ["projects", "ide", "terminal"],
    "intelligence": ["memory", "knowledge", "mcp", "marketplace", "flowgraph"],
    "infrastructure": ["runtime", "observability", "project"],
    "validation": ["browser"]
  },
  "screens": {
    "city": {"purpose":"runtime visual, workers e métricas","readEndpoints":["/api/v2/living-city/state"]},
    "agents": {"purpose":"agentes e subagentes","readEndpoints":["/api/agents/panel","/api/agents/swarm","/api/v2/agents/live-states"]},
    "ide": {"purpose":"chat, código, preview e edição visual","readEndpoints":["/api/dev/fs","/api/project-mirror"],"actionEndpoints":[{"endpoint":"/api/v2/vision/inspect-element","method":"POST"}]},
    "operations": {"purpose":"missões, jobs e controle operacional","readEndpoints":["/api/fenix/missions","/api/fenix/jobs","/api/v2/jarvis/jobs"]},
    "runtime": {"purpose":"health, serviços e workers","readEndpoints":["/health","/api/v2/living-city/state"]},
    "projects": {"purpose":"projetos acoplados e grafo","readEndpoints":["/api/v2/projects","/api/project-mirror/projects"]},
      "memory": {"purpose":"memória de engenharia e visual","readEndpoints":["/api/fenix/memory/search","/api/v2/memory/development"]},
    "knowledge": {"purpose":"conhecimento e grafo","readEndpoints":["/api/knowledge-federation/publications"]},
    "mcp": {"purpose":"conectores e providers","readEndpoints":["/api/connectors","/api/fenix/providers"]},
    "browser": {"purpose":"QA visual e auditoria de interação","readEndpoints":["/api/v2/frontend-reality/screens","/api/v2/frontend-reality/audit"]},
    "observability": {"purpose":"métricas, séries e evidências","readEndpoints":["/api/observability/metrics","/api/observability/series"]},
    "terminal": {"purpose":"filesystem, terminal isolado e preview","readEndpoints":["/api/dev/fs"],"actionEndpoints":[{"endpoint":"/api/dev/terminal","method":"POST"}]},
    "project": {"purpose":"Project Mirror e arquitetura do projeto","readEndpoints":["/api/project-mirror","/api/v2/projects"]},
    "marketplace": {"purpose":"skills e conectores registrados no runtime","readEndpoints":["/api/skills","/api/connectors"]},
    "flowgraph": {"purpose":"grafo de relações entre telas, agentes, jobs, memória e projetos","readEndpoints":["/api/v2/living-city/agents","/api/v2/jobs","/api/missions","/api/v2/projects","/api/fenix/memory/graph","/api/v2/observatory/summary"]}
  },
  "legacyRoutes": {"command":"city","home":"city","dashboard":"city","dna":"knowledge","metrics":"observability","flow-graph":"flowgraph"},
  "acceptance": {"oneVisibleView":true,"hashMatchesView":true,"noFatalConsoleError":true,"noMockData":true}
}
