FENIX_ENV=development
FENIX_ALLOW_DEV_HEADERS=0
FENIX_KILL_SWITCH=0
FENIX_SESSION_TTL_MS=43200000
FENIX_LOGIN_RATE_LIMIT=10
FENIX_API_RATE_LIMIT=300
FENIX_RATE_WINDOW_MS=60000
FENIX_PORT=4400

# Runtime universal: BullMQ aciona o job persistido; polling so existe como fallback sem fila.
FENIX_WORKERS_ENABLED=1
FENIX_WORKER_CONCURRENCY=5
FENIX_WORKER_POLL_MS=2000
FENIX_WORKER_BATCH=10
FENIX_STALE_JOB_MS=60000
FENIX_LIVING_RUNTIME=1
FENIX_LIVING_TICK_MS=2000
FENIX_WORKTREE_ROOT=.data/worktrees

# Bootstrap é somente para provisionamento local/teste e é proibido em production.
FENIX_BOOTSTRAP_TENANT_ID=grg
FENIX_BOOTSTRAP_TENANT_NAME=GRG FENIX
FENIX_BOOTSTRAP_ADMIN_USER=
FENIX_BOOTSTRAP_ADMIN_PASSWORD=
FENIX_BOOTSTRAP_ADMIN_NAME=

GRG_DATA_FILE=.data/state.json
# Em production, DATABASE_URL, REDIS_URL e S3 sÃ£o obrigatÃ³rios.
DATABASE_URL=
FENIX_DATABASE_SCHEMA=fenix
REDIS_URL=
FENIX_QUEUE_REDIS_URL=
FENIX_QDRANT_URL=
FENIX_QDRANT_API_KEY=
FENIX_QDRANT_COLLECTION=fenix_memory
FENIX_QDRANT_DIMENSIONS=64
FENIX_DISCOVERY_DOCKER=0
FENIX_DEPLOY_DRIVER=
FENIX_DEPLOY_PUBLIC_BASE_URL=http://127.0.0.1
FENIX_DEPLOY_DOCKER_NETWORK=fenix-apps
FENIX_S3_ENDPOINT=
FENIX_S3_REGION=us-east-1
FENIX_S3_BUCKET=fenix-artifacts
FENIX_S3_ACCESS_KEY_ID=
FENIX_S3_SECRET_ACCESS_KEY=
FENIX_S3_FORCE_PATH_STYLE=1

# AI Gateway. Chaves devem ser injetadas por secret manager em production.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
FENIX_OPENAI_COMPATIBLE_URL=
FENIX_OPENAI_COMPATIBLE_KEY=
FENIX_AI_DEFAULT_PROVIDER=echo
FENIX_AI_DEFAULT_MODEL=echo-small
FENIX_AI_PLAN_PROVIDER=echo
FENIX_AI_PLAN_MODEL=echo-large
FENIX_AI_GENERATE_PROVIDER=echo
FENIX_AI_GENERATE_MODEL=echo-large
FENIX_AI_ROUTES_JSON=
FENIX_AI_RATE_LIMIT=60
FENIX_AI_RATE_WINDOW_MS=60000

# ---- Fonte de LLM (chat, voz, decomposicao de objetivo) --------------------------------
# Trocar de fonte = trocar FENIX_AI_DEFAULT_PROVIDER + a URL/chave do bloco correspondente.
# Prove ANTES de subir o app:  node ops/llm-preflight.js --env .env.production
#   exit 0 = inferencia real medida | 1 = config invalida | 2 = configurado mas nao respondeu
#
# AVISO: em producao, uma rota de IA apontando para provider nao registrado FAZ O BOOT FALHAR
# (src/app.js:109, "production AI routes require configured real providers"). Nao deixe
# GRG_AIPLATFORM_URL vazio com FENIX_AI_DEFAULT_PROVIDER=aiplatform -- ja causou restart loop.
#
# Em container, a chave NAO vem daqui: vem de /run/secrets/ai_provider_key e o
# ops/container-entrypoint.sh a exporta na variavel certa conforme o provider escolhido.
GRG_LLM=0

# Opcao 1 -- gateway AI Platform (multi-provider, HTTP com header x-api-key)
GRG_AIPLATFORM_URL=
GRG_AIPLATFORM_KEY=
GRG_AIPLATFORM_MODEL=
GRG_AIPLATFORM_JOB_WAIT_MS=120000
GRG_AIPLATFORM_JOB_POLL_MS=1000

# Opcao 2 -- Ollama (sem chave, sem custo). FENIX_ENABLE_OLLAMA=1 registra o provider no
# gateway; FENIX_OLLAMA_URL e OBRIGATORIO em container (127.0.0.1 la e o proprio container,
# onde nao ha Ollama). Nunca exponha a 11434 publicamente: Ollama nao tem autenticacao.
FENIX_ENABLE_OLLAMA=0
FENIX_OLLAMA_URL=
GRG_LLM_MODEL=qwen2.5:3b

# Streaming token a token para o chat de voz. O /v1/text do gateway nao faz stream; com este
# endereco direto do Ollama o FENIX consegue progressividade real em vez de resposta inteira.
GRG_OLLAMA_DIRECT_URL=
