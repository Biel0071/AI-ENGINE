  code: 'ERR_ASSERTION'
  name: 'AssertionError'
  expected:
  actual: |-
    :root {
      /* Colors inspired by Premium Glassmorphism & High-end IDEs */
      --bg-app: #030712;
      --bg-panel: rgba(15, 23, 42, 0.65);
      --bg-surface: rgba(30, 41, 59, 0.75);
      --bg-input: rgba(2, 6, 23, 0.5);
      --bg-glass-blur: blur(16px);
    
      --border: rgba(255, 255, 255, 0.08);
      --border-focus: #58a6ff;
    
      --text-main: #c9d1d9;
      --text-muted: #8b949e;
      --text-bright: #ffffff;
    
      --accent: #2f81f7;
      --accent-hover: #58a6ff;
    
      --green: #238636;
      --rose: #f85149;
      --warn: #d29922;
      --purple: #8957e5;
    
      --font-ui: "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --font-mono: "JetBrains Mono", Consolas, monospace;
    }
    
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--bg-app); color: var(--text-main); font-family: var(--font-ui); font-size: 13px; height: 100vh; overflow: hidden; }
    
    /* SCROLLBARS */
    ::-webkit-scrollbar { width: 10px; height: 10px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.1); border: 2px solid transparent; border-radius: 6px; }
    ::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.2); }
    
    /* LAYOUT */
    .fenix-os-layout { display: flex; flex-direction: column; height: 100vh; }
    .main-body { display: flex; flex: 1 1 0; min-height: 0; overflow: hidden; }
    
    .fenix-os-layout > .main-body { padding-right: 0 !important; box-sizing: border-box; }
    
    /* The Command Center rail is an in-flow component of #view-command */
    #view-command .orch-right-column {
      height: 100%;
      max-height: 100%;
      box-sizing: border-box;
    }
    
    /* Visual stability for the consolidated command center. */
    .orch-center-area { min-height: 0; overflow-x: hidden; }
    .orch-body-row { min-height: 0; }
    .orch-city-zone { flex: 0 0 auto; }
    .orch-bottom-trio { flex: 0 0 auto; min-height: 270px; }
    
    @media (max-width: 1280px) {
      .fenix-os-layout > .main-body { padding-right: 0 !important; }
      .orch-bottom-trio { grid-template-columns: 1fr 1fr; }
    }
    
    @media (max-width: 980px) {
      .fenix-os-layout > .main-body { padding-right: 0; }
      .fenix-os-layout > .orch-right-column { position: static; width: 100%; max-height: 360px; }
      .fenix-os-layout > .view { position: static; width: 100%; height: auto; min-height: 680px; }
      body > .view { position: static; width: 100%; height: auto; min-height: 680px; }
      .fenix-os-layout { overflow-y: auto; }
      .main-body { min-height: 680px; }
    }
    
    /* TOP GLOBAL BAR */
    .global-topbar {
      height: 40px; background: rgba(3, 7, 18, 0.85); backdrop-filter: var(--bg-glass-blur); -webkit-backdrop-filter: var(--bg-glass-blur); border-bottom: 1px solid rgba(255,255,255,0.08);
      display: flex; justify-content: space-between; align-items: center; padding: 0 16px;
      font-size: 12px; flex-shrink: 0; z-index: 50; position: relative;
    }
    .topbar-left, .topbar-metrics, .topbar-right { display: flex; align-items: center; gap: 20px; }
    .brand-logo { font-weight: 700; color: var(--text-bright); display: flex; align-items: center; gap: 8px; font-size: 14px; letter-spacing: 0.5px; }
    .brand-logo i { color: var(--accent); font-size: 16px; }
    .version-badge { background: rgba(255,255,255,0.1); padding: 2px 6px; border-radius: 4px; font-size: 9px; color: var(--text-muted); }
    .connection-status { font-weight: 600; font-size: 11px; display: flex; align-items: center; gap: 6px; }
    
    .metric { display: flex; flex-direction: column; line-height: 1.2; }
    .metric small { color: var(--text-muted); font-size: 9px; text-transform: uppercase; }
    .metric b { font-family: var(--font-mono); font-size: 11px; color: var(--text-main); font-weight: 500; }
    
    .user-info { display: flex; align-items: center; gap: 8px; }
    .user-info .avatar { width: 24px; height: 24px; background: var(--bg-surface); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
    .user-info span { display: flex; flex-direction: column; line-height: 1.2; }
    .user-info small { color: var(--accent); font-size: 9px; font-weight: 700; }
    
    .btn-ghost { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 16px; transition: 0.2s; }
    .btn-ghost:hover { color: var(--text-bright); }
    .btn-ghost-sm { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 12px; transition: 0.2s; font-weight: 600; text-transform: uppercase; }
    .btn-ghost-sm:hover { color: var(--accent); }
    
    /* NAV SIDEBAR (Tiniest bar) */
    .activity-bar {
      width: 48px; background: rgba(15, 23, 42, 0.4); border-right: 1px solid var(--border);
      backdrop-filter: var(--bg-glass-blur);
      display: flex; flex-direction: column; justify-content: space-between; align-items: center; padding: 12px 0;
      flex-shrink: 0; z-index: 20;
    }
    .nav-top, .nav-bottom { display: flex; flex-direction: column; gap: 12px; width: 100%; align-items: center; }
    .nav-item {
      width: 36px; height: 36px; border-radius: 8px; border: none; background: transparent;
      color: var(--text-muted); font-size: 20px; cursor: pointer; transition: 0.2s;
      display: flex; align-items: center; justify-content: center; position: relative;
    }
    .nav-item:hover { color: var(--text-bright); background: rgba(255,255,255,0.05); }
    .nav-item.active { color: var(--accent); }
    .nav-item.active::before { content: ''; position: absolute; left: -6px; top: 8px; bottom: 8px; width: 3px; background: var(--accent); border-radius: 4px; }
    
    /* VIEWS CONTAINER */
    .views-container { flex: 1 1 0; min-width: 0; min-height: 0; display: flex; overflow: hidden; position: relative; }
    .view { display: none; width: 100%; height: 100%; animation: fade 0.2s; }
    .view.active { display: flex; flex: 1 1 0; min-width: 0; min-height: 0; }
    @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    
    /* IDE SPLIT LAYOUT */
    .ide-split-layout { display: flex; width: 100%; height: 100%; background: transparent; }
    
    /* PANEL LEFT (Chat) */
    .panel-left { width: 320px; border-right: 1px solid var(--border); background: var(--bg-panel); display: flex; flex-direction: column; flex-shrink: 0; }
    .panel-tabs { display: flex; border-bottom: 1px solid var(--border); }
    .panel-tab { flex: 1; background: transparent; border: none; padding: 12px 0; font-size: 11px; font-weight: 600; color: var(--text-muted); cursor: pointer; border-bottom: 2px solid transparent; transition: 0.2s; }
    .panel-tab:hover { color: var(--text-main); background: rgba(255,255,255,0.02); }
    .panel-tab.active { color: var(--text-bright); border-bottom-color: var(--accent); }
    
    .panel-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .chat-view { display: flex; flex-direction: column; height: 100%; }
    .chat-history { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 24px; }
    .chat-bubble { display: flex; gap: 12px; }
    .chat-avatar { width: 28px; height: 28px; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 16px; flex-shrink: 0; }
    .chat-bot .chat-avatar { background: rgba(47,129,247,0.1); color: var(--accent); border: 1px solid rgba(47,129,247,0.2); }
    .chat-user .chat-avatar { background: var(--bg-surface); color: var(--text-main); border: 1px solid var(--border); }
    .chat-text-wrapper { display: flex; flex-direction: column; gap: 6px; width: 100%; }
    .chat-text-wrapper strong { font-size: 12px; color: var(--text-bright); font-weight: 600; display: flex; align-items: center; gap: 8px; }
    .badge-online { background: rgba(35,134,54,0.1); color: var(--green); padding: 2px 6px; border-radius: 12px; font-size: 9px; font-weight: 700; border: 1px solid rgba(35,134,54,0.4); text-transform: uppercase; }
    .chat-text { font-size: 13px; line-height: 1.5; color: var(--text-main); }
    .chat-text p { margin-bottom: 8px; }
    .chat-text pre { background: var(--bg-input); padding: 12px; border-radius: 6px; border: 1px solid var(--border); overflow-x: auto; margin-bottom: 8px; font-family: var(--font-mono); font-size: 11px; }
    .chat-text code { font-family: var(--font-mono); background: rgba(255,255,255,0.1); padding: 2px 4px; border-radius: 3px; font-size: 11px; }
    
    .chat-composer { padding: 16px; background: rgba(0,0,0,0.2); border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: 12px; }
    .chat-composer textarea { width: 100%; background: var(--bg-input); border: 1px solid var(--border); border-radius: 8px; padding: 12px; color: var(--text-main); font-family: var(--font-ui); font-size: 13px; resize: none; outline: none; transition: 0.2s; }
    .chat-composer textarea:focus { border-color: var(--border-focus); box-shadow: 0 0 0 2px rgba(88,166,255,0.2); }
    .composer-actions { display: flex; justify-content: space-between; align-items: center; }
    .composer-models { display: flex; align-items: center; gap: 6px; font-size: 11px; color: var(--text-muted); background: var(--bg-surface); padding: 4px 8px; border-radius: 4px; border: 1px solid var(--border); }
    
    /* PANEL CENTER (Visual / Code) */
    .panel-center { flex: 1; display: flex; flex-direction: column; min-width: 0; background: transparent; position: relative; }
    .editor-header { height: 48px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 16px; background: rgba(0,0,0,0.1); }
    .editor-title { font-size: 12px; font-weight: 600; color: var(--text-muted); display: flex; align-items: center; gap: 8px; letter-spacing: 0.5px; }
    .editor-toolbar { display: flex; align-items: center; background: var(--bg-input); border-radius: 6px; padding: 2px; border: 1px solid var(--border); }
    .toolbar-btn { background: transparent; border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 500; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 4px; }
    .toolbar-btn i { font-size: 14px; }
    .toolbar-btn:hover { color: var(--text-main); }
    .toolbar-btn.active { background: var(--bg-surface); color: var(--text-bright); box-shadow: 0 1px 4px rgba(0,0,0,0.2); }
    .toolbar-divider { width: 1px; height: 16px; background: var(--border); margin: 0 4px; }
    .btn-primary-sm { background: var(--accent); border: 1px solid var(--accent); color: #fff; padding: 6px 12px; border-radius: 6px; font-size: 12px; font-weight: 500; cursor: pointer; transition: 0.2s; display: flex; align-items: center; gap: 6px; }
    .btn-primary-sm:hover { background: var(--accent-hover); box-shadow: 0 0 12px rgba(47,129,247,0.4); }
    
    .editor-body { flex: 1; position: relative; display: flex; min-height: 0; }
    .visual-canvas { flex: 1; display: flex; align-items: center; justify-content: center; background: #0f1115; position: relative; }
    .visual-canvas iframe { width: 100%; height: 100%; background: #fff; border: none; }
    .visual-overlay { position: absolute; inset: 0; pointer-events: none; z-index: 10; }
    .monaco-container { flex: 1; }
    
    /* TERMINAL PANEL */
    .terminal-panel { height: 250px; border-top: 1px solid var(--border); display: flex; flex-direction: column; background: var(--bg-panel); flex-shrink: 0; }
    .terminal-header { height: 36px; border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; padding: 0 8px; }
    .terminal-tabs { display: flex; height: 100%; }
    .terminal-tab { background: transparent; border: none; border-bottom: 1px solid transparent; padding: 0 16px; font-size: 10px; font-weight: 600; color: var(--text-muted); letter-spacing: 0.5px; cursor: pointer; }
    .terminal-tab:hover { color: var(--text-main); }
    .terminal-tab.active { color: var(--accent); border-bottom-color: var(--accent); }
    .terminal-actions { display: flex; gap: 4px; }
    .icon-btn-small { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 14px; padding: 4px; border-radius: 4px; transition: 0.2s; display: flex; align-items: center; justify-content: center; }
    .icon-btn-small:hover { background: rgba(255,255,255,0.1); color: var(--text-bright); }
    .terminal-body { flex: 1; padding: 8px; background: rgba(0,0,0,0.5); overflow: hidden; position: relative; }
    .terminal-input-row { display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(0,0,0,0.5); border-top: 1px solid #222; }
    .prompt-char { color: var(--green); font-size: 14px; }
    .terminal-input-row input { flex: 1; background: transparent; border: none; outline: none; color: #fff; font-family: var(--font-mono); font-size: 12px; }
    
    /* PANEL RIGHT (Structure) */
    .panel-right { width: 260px; border-left: 1px solid var(--border); background: var(--bg-panel); display: flex; flex-direction: column; flex-shrink: 0; }
    .panel-header { padding: 10px 16px; font-size: 10px; font-weight: 700; color: var(--text-muted); display: flex; justify-content: space-between; align-items: center; letter-spacing: 0.5px; }
    .fs-explorer { flex: 1; overflow-y: auto; padding: 4px 0; }
    .fs-tree { display: flex; flex-direction: column; }
    .fs-item { display: flex; align-items: center; gap: 6px; padding: 4px 16px 4px 16px; font-size: 12px; color: var(--text-muted); cursor: pointer; user-select: none; transition: 0.1s; }
    .fs-item:hover { background: var(--bg-surface); color: var(--text-main); }
    .fs-item.active { background: rgba(47,129,247,0.1); color: var(--accent); }
    .fs-item i { font-size: 16px; }
    .fs-item.dir i { color: var(--warn); }
    .fs-item.file i { color: var(--text-muted); }
    .hidden-input { display: none; }
    
    .agents-mini-list { padding: 8px 16px; display: flex; flex-direction: column; gap: 8px; overflow-y: auto; max-height: 250px; }
    .agent-mini { display: flex; align-items: center; justify-content: space-between; background: var(--bg-surface); padding: 8px; border-radius: 6px; border: 1px solid var(--border); }
    .agent-mini-info { display: flex; align-items: center; gap: 8px; }
    .agent-mini-info i { color: var(--accent); font-size: 16px; }
    .agent-mini-name { font-size: 11px; font-weight: 600; color: var(--text-main); }
    .agent-mini-status { font-size: 9px; text-transform: uppercase; padding: 2px 4px; border-radius: 4px; font-weight: 700; }
    .status-running { background: rgba(35,134,54,0.1); color: var(--green); border: 1px solid rgba(35,134,54,0.4); }
    .status-idle { background: rgba(139,148,158,0.1); color: var(--text-muted); border: 1px solid rgba(139,148,158,0.4); }
    
    .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 20px; text-align: center; color: var(--text-muted); gap: 12px; }
    .empty-state i { font-size: 32px; opacity: 0.5; }
    
    /* Isometric & Glassmorphism Details */
    .panel-left, .panel-center, .panel-right {
      backdrop-filter: var(--bg-glass-blur);
      -webkit-backdrop-filter: var(--bg-glass-blur);
      border-color: rgba(255,255,255,0.08);
    }
    
    .editor-header {
      background: rgba(0,0,0,0.2);
    }
    
    .terminal-header {
      background: rgba(0,0,0,0.3);
    }
    
    .btn-send {
      background: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%);
      box-shadow: 0 4px 15px rgba(59,130,246,0.4);
      color: #fff; border: none; width: 32px; height: 32px; border-radius: 8px; display: flex; align-items: center; justify-content: center; font-size: 16px; cursor: pointer; transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .btn-send:hover {
      background: linear-gradient(135deg, #a78bfa 0%, #60a5fa 100%);
      box-shadow: 0 0 25px rgba(139,92,246,0.7);
      transform: translateY(-2px) scale(1.05);
    }
    
    .status-running {
      animation: pulse-green 2s infinite;
    }
    
    @keyframes pulse-green {
      0% { box-shadow: 0 0 0 0 rgba(35,134,54,0.4); }
      70% { box-shadow: 0 0 0 6px rgba(35,134,54,0); }
      100% { box-shadow: 0 0 0 0 rgba(35,134,54,0); }
    }
    
    /* Scrollbar styling enhanced */
    ::-webkit-scrollbar-thumb {
      background: rgba(255,255,255,0.15);
      border: 2px solid transparent;
      border-radius: 8px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: rgba(47,129,247,0.4);
    }
    
    /* Fully responsive mobile adaptions */
    @media (max-width: 768px) {
      .ide-split-layout { flex-direction: column; }
      .panel-left { width: 100%; height: 300px; border-right: none; border-bottom: 1px solid var(--border); }
      .panel-right { display: none; }
      .panel-center { min-height: 400px; }
      .global-topbar { padding: 0 8px; }
      .topbar-metrics { display: none; }
    }
    
    /* Glowing text for brand */
    .brand-logo i {
      filter: drop-shadow(0 0 5px rgba(47,129,247,0.8));
    }
    .is-preview-mode .sidebar-nav { display: none !important; }
    .is-preview-mode #view-ide { display: none !important; }
    .is-preview-mode .cmd-panel-ide { display: none !important; }
    .is-preview-mode .command-center-grid { grid-template-columns: 1fr 1fr 1fr; grid-template-areas: "city city city" "agents runtime projects" "knowledge observability qa"; }
    .split-handle { width: 4px; background: rgba(255,255,255,0.05); cursor: col-resize; transition: background 0.2s; z-index: 10; }
    .split-handle:hover, .split-handle.dragging { background: var(--accent); }
    .ide-split-layout { display: flex; width: 100%; height: 100%; }
    
    #view-ide {
      flex-direction: column;
    }
    .split-handle-horiz { height: 4px; background: rgba(255,255,255,0.05); cursor: row-resize; transition: background 0.2s; z-index: 10; width: 100%; }
    .split-handle-horiz:hover, .split-handle-horiz.dragging { background: var(--accent); }
    #globalTerminalPanel { flex-shrink: 0; display: flex; flex-direction: column; background: var(--bg-panel); border-top: 1px solid var(--border); height: 200px; }
    .ide-split-layout { flex: 1; height: auto !important; overflow: hidden; }
    
    /* Canonical operational views */
    .sidebar-nav { width: 112px; background: rgba(15, 23, 42, 0.4); backdrop-filter: var(--bg-glass-blur); border-right: 1px solid var(--border); display: flex; flex-direction: column; justify-content: space-between; flex-shrink: 0; padding: 10px 8px; overflow-y: auto; z-index: 20; }
    .sidebar-nav .nav-item { width: 100%; height: 34px; justify-content: flex-start; gap: 8px; padding: 0 8px; font-size: 10px; font-weight: 700; }
    .sidebar-nav .nav-item i { font-size: 16px; }
    .sidebar-nav .nav-item.active::before { left: -8px; }
    .nav-group { margin-bottom: 10px; }
    .nav-group-label { display: flex; width: 100%; justify-content: space-between; padding: 0 8px 4px; color: var(--text-muted); background: transparent; border: 0; font: inherit; font-size: 9px; letter-spacing: .12em; cursor: pointer; text-align: left; }
    .nav-group-label:hover { color: var(--text-main); }
    .nav-group.is-collapsed .nav-item { display: none; }
    .system-health { display: grid; gap: 4px; padding: 8px; color: var(--text-muted); font-size: 9px; overflow-wrap: anywhere; }
    .workspace-view { width: 100%; height: 100%; overflow: auto; padding: 24px; background: transparent; }
    .workspace-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 20px; }
    .workspace-header small { color: var(--accent); font-weight: 700; letter-spacing: .12em; }
    .workspace-header h1 { color: var(--text-bright); font-size: 24px; margin-top: 4px; }
    .workspace-grid { display: grid; gap: 16px; }
    .workspace-grid.two-columns { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .workspace-grid.three-columns { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .workspace-card { min-width: 0; padding: 16px; background: var(--bg-panel); border: 1px solid var(--border); border-radius: 10px; overflow: auto; backdrop-filter: var(--bg-glass-blur); }
    .workspace-card h2 { color: var(--text-bright); font-size: 13px; margin-bottom: 14px; }
    .workspace-card table { width: 100%; border-collapse: collapse; }
    .workspace-card td { padding: 9px 6px; border-bottom: 1px solid var(--border); vertical-align: top; }
    .workspace-card input, .workspace-card textarea, .workspace-card select { width: 100%; color: var(--text-main); background: var(--bg-input); border: 1px solid var(--border); border-radius: 6px; padding: 9px; font-family: inherit; }
    .workspace-card textarea, .text-output { font-family: var(--font-mono); }
    .workspace-card button, .workspace-header button { color: white; background: var(--accent); border: 0; border-radius: 6px; padding: 9px 12px; cursor: pointer; transition: 0.2s; }
    .workspace-card button:hover, .workspace-header button:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(47, 129, 247, 0.4); background: var(--accent-hover); }
    .toolbar-row { display: flex; gap: 8px; align-items: center; margin-bottom: 12px; }
    .stack-form { display: grid; gap: 9px; }
    .full-span { grid-column: 1 / -1; }
    .text-output { white-space: pre-wrap; overflow-wrap: anywhere; min-height: 44px; margin-top: 10px; padding: 10px; color: var(--text-muted); background: var(--bg-input); border-radius: 6px; overflow: auto; }
    .metric-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 8px; }
    .metric-grid > div { padding: 10px; background: var(--bg-input); border-radius: 6px; display: grid; gap: 4px; }
    .metric-grid span, .metric-grid small { color: var(--text-muted); }
    #livePreviewFrame { width: 100%; min-height: 340px; background: white; border: 1px solid var(--border); border-radius: 6px; }
    
    #view-city {
      position: relative;
      background: transparent;
    }
    
    #cityCanvas {
      width: 100%;
      height: 100%;
      display: block;
      background: transparent;
    }
    
    .runtime-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      min-height: 28px;
      padding: 7px 10px;
      border-bottom: 1px solid rgba(255,255,255,0.05);
      color: var(--text-main);
      font-size: 11px;
    }
    
    .runtime-row b {
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--text-bright);
      font-weight: 650;
    }
    
    .runtime-row span {
      flex: 1;
      min-width: 0;
      max-width: 44%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 10px;
      text-align: right;
    }
    
    .runtime-status {
      flex: 0 0 auto;
      min-width: 62px;
      padding: 2px 6px;
      border-radius: 999px;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(255,255,255,0.05);
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 9px;
      font-weight: 800;
      text-align: center;
    }
    
    .runtime-status.ok { color: #3ddc84; border-color: rgba(61,220,132,0.35); background: rgba(61,220,132,0.10); }
    .runtime-status.warn { color: #fbbf24; border-color: rgba(251,191,36,0.35); background: rgba(251,191,36,0.10); }
    .runtime-status.bad { color: #fb7185; border-color: rgba(251,113,133,0.35); background: rgba(251,113,133,0.10); }
    .runtime-status.muted { color: #94a3b8; }
    
    .runtime-summary {
      display: grid;
      align-content: center;
      justify-items: center;
      gap: 6px;
      height: 100%;
      min-height: 72px;
      color: var(--text-muted);
    }
    
    .runtime-summary small {
      color: var(--accent-hover);
      font-size: 10px;
      letter-spacing: .12em;
    }
    
    .runtime-summary b {
      color: var(--text-bright);
      font-family: var(--font-mono);
      font-size: 26px;
    }
    
    .runtime-summary span {
      color: var(--text-muted);
      font-size: 10px;
    }
    
    .mission-card {
      display: grid;
      gap: 12px;
      padding: 14px;
      color: var(--text-main);
    }
    
    .mission-title {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 10px;
    }
    
    .mission-title b {
      color: var(--text-bright);
      line-height: 1.35;
    }
    
    .mission-card small {
      color: var(--text-muted);
      font-family: var(--font-mono);
      font-size: 10px;
    }
    
    .mission-track {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 6px;
    }
    
    .mission-track span {
      overflow: hidden;
      text-overflow: ellipsis;
      padding-top: 10px;
      border-top: 3px solid rgba(255,255,255,0.1);
      color: var(--text-muted);
      font-size: 8px;
      font-weight: 800;
      text-align: center;
    }
    
    .mission-track span.done,
    .mission-track span.ok {
      border-top-color: #3ddc84;
      color: #bbf7d0;
    }
    
    .mission-track span.warn {
      border-top-color: #fbbf24;
      color: #fde68a;
    }
    
    .job-board-mini {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(128px, 1fr));
      gap: 8px;
      padding: 10px;
    }
    
    .job-card-mini {
      display: grid;
      gap: 8px;
      min-height: 92px;
      padding: 10px;
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 8px;
      background: rgba(0, 0, 0, 0.2);
    }
    
    .job-card-mini strong {
      color: var(--text-bright);
      font-family: var(--font-mono);
      font-size: 11px;
    }
    
    .job-card-mini span {
      color: var(--text-main);
      font-size: 11px;
      line-height: 1.35;
    }
    
    .job-card-mini.ok { border-color: rgba(61,220,132,0.28); }
    .job-card-mini.warn { border-color: rgba(251,191,36,0.28); }
    .job-card-mini.bad { border-color: rgba(251,113,133,0.28); }
    
    .empty-state-mini {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      min-height: 64px;
      padding: 12px;
      color: var(--text-muted);
      font-size: 11px;
      line-height: 1.45;
      text-align: center;
    }
    
    @media (max-width: 1000px) {
      .workspace-grid.two-columns, .workspace-grid.three-columns { grid-template-columns: 1fr; }
      .full-span { grid-column: auto; }
    }
    
