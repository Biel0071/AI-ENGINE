POSTGRES_DB=fenix
POSTGRES_USER=fenix
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
POSTGRES_PORT=5432
REDIS_PASSWORD_FILE=./secrets/redis_password.txt
REDIS_PORT=6379
QDRANT_PORT=6333

DATABASE_URL=postgresql://fenix:CHANGE_ME@127.0.0.1:5432/fenix
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
FENIX_QUEUE_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/1
FENIX_WORKERS_ENABLED=1
FENIX_WORKER_CONCURRENCY=5
FENIX_WORKER_POLL_MS=2000
FENIX_WORKER_BATCH=10
FENIX_STALE_JOB_MS=60000
FENIX_LIVING_RUNTIME=1
FENIX_LIVING_TICK_MS=2000
FENIX_WORKTREE_ROOT=/app/workspaces/.fenix-worktrees
FENIX_QDRANT_URL=http://127.0.0.1:6333
FENIX_QDRANT_API_KEY=
FENIX_QDRANT_COLLECTION=fenix_memory
FENIX_QDRANT_DIMENSIONS=64

# Configure um bucket AWS S3 ou endpoint S3-compatible mantido e corrigido.
FENIX_S3_ENDPOINT=
FENIX_S3_REGION=us-east-1
FENIX_S3_BUCKET=fenix-artifacts
FENIX_S3_ACCESS_KEY_ID=
FENIX_S3_SECRET_ACCESS_KEY=
FENIX_S3_FORCE_PATH_STYLE=1
