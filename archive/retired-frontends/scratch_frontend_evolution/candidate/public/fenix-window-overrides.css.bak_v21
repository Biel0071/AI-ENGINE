/* Canonical shell geometry. Legacy module visuals remain scoped to their views. */
:root { --surface:#111a28; --border:#29364a; --text:#e5edf7; --muted:#a3b2c8; }
* { box-sizing:border-box; }
html,body { margin:0!important; width:100%; height:100%; overflow:hidden!important; }
body.dark-theme { background:#0b1220!important; color:var(--text); font:14px/1.5 Inter,system-ui,sans-serif; }
.fenix-os-layout { display:flex!important; flex-direction:column!important; width:100%!important; height:100dvh!important; overflow:hidden!important; background:#0b1220!important; }
.global-topbar { position:relative!important; inset:auto!important; width:100%!important; height:60px!important; min-height:60px!important; flex:none!important; padding:0 18px!important; gap:16px; box-shadow:none!important; background:#101827!important; }
.main-body { display:flex!important; flex:1!important; min-height:0!important; width:100%!important; padding:0!important; overflow:hidden!important; }
#mainSidebarNav { position:relative!important; inset:auto!important; width:224px!important; flex:0 0 224px!important; height:100%!important; overflow-y:auto!important; overflow-x:hidden!important; padding:14px 10px!important; background:#101827!important; border-right:1px solid var(--border)!important; }
.views-container { position:relative!important; inset:auto!important; flex:1!important; width:0!important; min-width:0!important; height:100%!important; overflow:hidden!important; margin:0!important; padding:0!important; }
.views-container>.view { position:absolute!important; inset:0!important; width:100%!important; height:100%!important; min-width:0!important; min-height:0!important; overflow:auto!important; background:#0b1220!important; }
.view:not(.active) { display:none!important; }
.view.active { flex-direction:column; }
.workspace-view { width:100%!important; max-width:1600px; margin:0 auto!important; padding:28px!important; overflow:visible!important; min-width:0!important; height:auto!important; }
.workspace-header { display:flex; align-items:center; justify-content:space-between; gap:16px; flex-wrap:wrap; margin-bottom:24px; background:none!important; }
h1 { font-size:26px!important; line-height:1.25!important; letter-spacing:-.6px; } h2 {font-size:16px!important;} h3{font-size:14px!important;}
.workspace-grid { display:grid!important; gap:18px!important; align-items:start; }
.two-columns {grid-template-columns:repeat(2,minmax(0,1fr))!important;}.three-columns {grid-template-columns:repeat(3,minmax(0,1fr))!important;}
.workspace-card,.v10-right-card,.v10-stat-card { background:var(--surface)!important; border:1px solid var(--border)!important; border-radius:12px!important; padding:18px!important; min-width:0; box-shadow:none!important; }
.workspace-card { height:auto!important; } .full-span {grid-column:1/-1;}
button,.btn,.fp-btn { font:inherit; color:var(--text); background:#1c2b40; border:1px solid #374962; border-radius:7px; min-height:34px; padding:7px 12px; cursor:pointer; box-shadow:none!important; text-shadow:none!important; }
button:hover,.btn:hover {background:#263b58;transform:none!important;}button:disabled{opacity:.55;cursor:not-allowed;}
input,textarea,select { font:inherit; color:var(--text)!important; background:#0d1625!important; border:1px solid #374962!important; border-radius:7px!important; padding:9px 11px!important; min-width:0; max-width:100%; }
input::placeholder,textarea::placeholder{color:#91a2ba!important;} :focus-visible {outline:2px solid #78b5ff!important;outline-offset:3px!important;}
.v10-nav-btn { width:100%; text-align:left; min-height:40px; white-space:normal!important; gap:10px!important; border:0!important; background:transparent!important; color:#b9c6d9!important; padding:9px 10px!important; }
.v10-nav-btn span { overflow:visible!important; white-space:normal!important;font-size:13px!important;line-height:1.3; }
.v10-nav-btn.active { background:#203c63!important; color:#fff!important; box-shadow:none!important; }.v10-nav-btn:before,.v10-nav-btn:after{display:none!important;}
.v10-nav-group-header { margin-top:12px; }.v10-sidebar-brand-card{margin-top:24px!important;}
#view-command {padding:26px!important; display:grid!important;grid-template-columns:minmax(0,1fr) 300px!important;gap:22px!important;align-content:start!important;}
#view-command:not(.active){display:none!important;}
#view-command .orch-body-row,#view-command .orch-center-area {display:block!important;position:static!important;inset:auto!important;min-width:0!important;width:100%!important;height:auto!important;overflow:visible!important;padding:0!important;margin:0!important;}
#view-command .orch-right-column {position:static!important;inset:auto!important;transform:none!important;width:100%!important;height:auto!important;overflow:visible!important;padding:0!important;display:flex!important;flex-direction:column;gap:16px;background:none!important;border:0!important;}
#v10Breadcrumbs {gap:12px;flex-wrap:wrap;margin-bottom:24px!important;}
.v10-welcome-banner {margin-bottom:24px!important;align-items:start!important;}.v10-welcome-right{display:none!important;}
.v10-stats-row,.v10-stats-grid {display:grid!important;grid-template-columns:repeat(auto-fit,minmax(130px,1fr))!important;gap:12px!important;flex-wrap:wrap!important;}
#wsCityContainer {width:100%!important;height:auto!important;min-height:300px!important;margin:24px 0!important;overflow:hidden!important;}
.v10-city-hero-visual {min-height:280px!important;}.v10-city-hero-card img{width:100%;object-fit:cover;}
.v10-dock,.v10-dock-hint,#v10MascotWidget,#fv8-toggle-btn,.mesh-background,.v10-window-controls {display:none!important;}
.v10-right-card svg {max-width:100%;}.v10-nav-btn,.v10-stat-card {backdrop-filter:none!important;}
.view table {width:100%;border-collapse:collapse;table-layout:fixed;} .view td,.view th{padding:12px 8px;border-bottom:1px solid var(--border);overflow-wrap:anywhere;text-align:left;vertical-align:top;}
.view pre,.text-output {white-space:pre-wrap!important;overflow-wrap:anywhere;max-width:100%;color:#c1cee0;}
.metric-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;}.metric-grid>div{padding:14px;background:#172337;border-radius:8px;}
.evolution-state {padding:18px;color:var(--muted);border:1px dashed #43536a;border-radius:8px;grid-column:1/-1;}.evolution-state strong{display:block;color:#f3c979;margin-bottom:5px;}.evolution-state button{margin-top:12px;}
.evolution-toolbar {display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin:0 0 18px;}.evolution-toolbar input{flex:1;min-width:140px;}.evolution-meta{font-size:12px;color:var(--muted);margin:10px 0;}
.evolution-row {padding:14px;border-bottom:1px solid var(--border);}.evolution-row summary{cursor:pointer;display:flex;gap:12px;justify-content:space-between;}.evolution-row small{color:var(--muted);}.evolution-row pre{font-size:12px;}
.evolution-badge {display:inline-block;padding:3px 8px;border-radius:6px;background:#22334a;color:#c5d8ef;font-size:12px;}
.evolution-dialog {color:var(--text);background:#111b2b;border:1px solid #415572;border-radius:14px;width:min(680px,94vw);max-height:88dvh;padding:24px;overflow:auto;}.evolution-dialog::backdrop{background:#030916b8;}.evolution-dialog header{display:flex;justify-content:space-between;align-items:start;gap:16px;}.evolution-dialog textarea{width:100%;min-height:100px;}.evolution-dialog footer{display:flex;gap:10px;margin-top:18px;flex-wrap:wrap;}
#view-ide .ide-split-layout {display:grid!important;grid-template-columns:minmax(220px,27%) minmax(280px,1fr) minmax(190px,23%);height:100%!important;min-width:0;width:100%!important;}
#view-ide .panel-left,#view-ide .panel-center,#view-ide .panel-right {width:auto!important;min-width:0!important;overflow:auto!important;}.split-handle{display:none!important;}.panel-tabs{display:flex;overflow-x:auto;flex-shrink:0;}.panel-tabs>*{flex-shrink:0;}
#view-projects.active {display:flex!important;flex-direction:row!important;}.fp-hub-sidebar{flex:0 0 190px!important;width:190px!important;min-width:0!important;}.fp-hub-main,.fp-workspace{min-width:0!important;flex:1!important;}.fp-projects-grid{grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))!important;}.fp-hub-toolbar,.fp-toolbar,.fp-filters{flex-wrap:wrap;}.fp-ws-tabs{overflow-x:auto;flex-shrink:0;}
#view-city {overflow:hidden!important;}#cityStatusHud{flex-shrink:0;}.city-tab-btn{flex-shrink:0;}#cityEventFeed{overflow:auto!important;}.city-control-bar{flex-wrap:wrap!important;}
#view-project .project-sidebar{flex:0 0 175px!important;width:175px!important;}#view-project{flex-direction:row!important;}
body.sidebar-collapsed #mainSidebarNav {display:none!important;}
@media(max-width:1250px){#view-command{grid-template-columns:minmax(0,1fr)!important;}#view-command .orch-right-column{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr));}.global-topbar{gap:8px!important;}.v10-topbar-clock{display:none!important;}.three-columns{grid-template-columns:repeat(2,minmax(0,1fr))!important;}}
@media(max-width:900px){#mainSidebarNav{position:absolute!important;top:60px!important;bottom:0!important;left:0!important;height:calc(100dvh - 60px)!important;z-index:90;display:none!important;}body.menu-open #mainSidebarNav{display:block!important;}.workspace-view,#view-command{padding:18px!important;}.two-columns,.three-columns{grid-template-columns:1fr!important;}.global-topbar .v10-search-bar{max-width:240px!important;}.fp-hub-sidebar{display:none!important;}#view-ide .ide-split-layout{grid-template-columns:1fr!important;height:auto!important;}#view-ide .panel-left{min-height:400px;}#view-ide .panel-center{min-height:500px;}#view-ide .panel-right{min-height:250px;}#view-project .project-sidebar{flex:0 0 140px!important;width:140px!important;}}
@media(max-width:600px){.global-topbar{padding:0 10px!important;}.v10-topbar-center,.v10-search-container,.v10-global-search,.v10-topbar-datetime,.v10-brand-tagline,.v10-topbar-status,.v10-profile-info{display:none!important;}#view-command .orch-right-column{grid-template-columns:1fr!important;}.v10-welcome-title{font-size:25px!important;}.v10-city-header{flex-wrap:wrap;gap:8px;}.evolution-dialog{padding:18px;}#view-project .project-sidebar{flex:0 0 105px!important;width:105px!important;padding:8px!important;}.workspace-view{padding:14px!important;}#view-city #cityStatusHud{max-height:120px;overflow:auto;} }
@media(prefers-reduced-motion:reduce){*,*:before,*:after{animation:none!important;transition:none!important;scroll-behavior:auto!important;}}



/* ==========================================================================
   FENIX OS v2.1 OPERATIONAL OS LAYER STYLES
   ========================================================================== */

/* 1. Context Bar */
.fenix-context-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 6px 20px;
  background: rgba(15, 23, 42, 0.95);
  border-bottom: 1px solid rgba(56, 189, 248, 0.2);
  font-size: 11px;
  color: #94a3b8;
  z-index: 40;
  backdrop-filter: blur(8px);
}
.fenix-context-info {
  display: flex;
  align-items: center;
  gap: 8px;
}
.fenix-context-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #38bdf8;
  box-shadow: 0 0 8px #38bdf8;
}
.fenix-context-label {
  font-weight: 800;
  letter-spacing: 0.05em;
  color: #64748b;
  font-size: 10px;
}
.fenix-context-project {
  color: #f8fafc;
  font-size: 12px;
}
.fenix-context-actions {
  display: flex;
  gap: 6px;
}
.fenix-context-actions button {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #cbd5e1;
  padding: 3px 8px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 11px;
  transition: all 0.15s ease;
}
.fenix-context-actions button:hover {
  background: rgba(56, 189, 248, 0.15);
  border-color: rgba(56, 189, 248, 0.3);
  color: #38bdf8;
}

/* 2. Unified Inspector Drawer */
.fenix-inspector-drawer {
  position: fixed;
  top: 60px;
  right: -450px;
  width: 420px;
  height: calc(100vh - 60px);
  background: #090d1a;
  border-left: 1px solid rgba(255, 255, 255, 0.1);
  box-shadow: -10px 0 30px rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  flex-direction: column;
  transition: right 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  color: #e2e8f0;
}
.fenix-inspector-drawer.open {
  right: 0;
}
.fenix-drawer-header {
  padding: 16px 20px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(255, 255, 255, 0.02);
}
.fenix-drawer-title-group h3 {
  margin: 4px 0 0;
  font-size: 15px;
  font-weight: 700;
  color: #f8fafc;
}
.fenix-drawer-badge {
  font-size: 9px;
  font-weight: 800;
  padding: 2px 6px;
  border-radius: 4px;
  background: rgba(56, 189, 248, 0.15);
  color: #38bdf8;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.fenix-drawer-close {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #94a3b8;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}
.fenix-drawer-close:hover {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
}
.fenix-drawer-body {
  flex: 1;
  overflow-y: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.fenix-drawer-footer {
  padding: 14px 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  background: rgba(255, 255, 255, 0.02);
  display: flex;
  gap: 10px;
}

/* Inspector Internal Sections */
.fenix-insp-section {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 8px;
  padding: 14px;
}
.fenix-insp-section h5 {
  margin: 0 0 10px;
  font-size: 12px;
  font-weight: 700;
  color: #cbd5e1;
  letter-spacing: 0.02em;
}
.fenix-insp-agent-head {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 12px;
}
.fenix-insp-avatar {
  font-size: 28px;
  line-height: 1;
}
.fenix-insp-sub {
  margin: 2px 0 0;
  font-size: 11px;
  color: #94a3b8;
}
.fenix-insp-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12px;
}
.fenix-insp-grid small {
  display: block;
  font-size: 10px;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  margin-bottom: 2px;
}
.fenix-insp-grid p {
  margin: 0;
  font-size: 12px;
  color: #f1f5f9;
  font-weight: 600;
}
.fenix-insp-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  color: #cbd5e1;
}
.fenix-insp-code {
  background: #050811;
  border: 1px solid rgba(255, 255, 255, 0.05);
  border-radius: 6px;
  padding: 10px;
  font-size: 11px;
  font-family: monospace;
  color: #38bdf8;
  max-height: 200px;
  overflow: auto;
  white-space: pre-wrap;
  word-break: break-all;
}
.fenix-action-btn {
  flex: 1;
  padding: 8px 12px;
  border-radius: 6px;
  border: 1px solid rgba(255, 255, 255, 0.1);
  background: rgba(255, 255, 255, 0.04);
  color: #e2e8f0;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s ease;
}
.fenix-action-btn:hover {
  background: rgba(255, 255, 255, 0.08);
  color: #fff;
}
.fenix-action-btn.primary {
  background: #0284c7;
  border-color: #38bdf8;
  color: #fff;
}
.fenix-action-btn.primary:hover {
  background: #0369a1;
}

/* 3. Global State Cards */
.fenix-state-card {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 16px;
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.08);
  font-size: 12px;
}
.fenix-state-icon {
  font-size: 20px;
  line-height: 1;
}
.fenix-state-content strong {
  display: block;
  font-size: 13px;
  color: #f8fafc;
  margin-bottom: 2px;
}
.fenix-state-content p {
  margin: 0 0 6px;
  color: #94a3b8;
}
.fenix-state-details {
  display: block;
  font-family: monospace;
  color: #ef4444;
  font-size: 10px;
  margin-bottom: 8px;
}
.fenix-state-btn {
  background: rgba(56, 189, 248, 0.15);
  border: 1px solid rgba(56, 189, 248, 0.3);
  color: #38bdf8;
  padding: 4px 10px;
  border-radius: 4px;
  cursor: pointer;
  font-size: 11px;
  font-weight: 600;
}

/* 4. Terminal Quick Bar & History */
.fenix-quick-bar {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-bottom: 10px;
  flex-wrap: wrap;
}
.fenix-quick-bar small {
  color: #64748b;
  font-size: 11px;
  font-weight: 700;
  text-transform: uppercase;
  margin-right: 4px;
}
.fenix-quick-bar button {
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #38bdf8;
  font-family: monospace;
  font-size: 11px;
  padding: 3px 8px;
  border-radius: 4px;
  cursor: pointer;
  transition: all 0.15s ease;
}
.fenix-quick-bar button:hover {
  background: rgba(56, 189, 248, 0.2);
  border-color: #38bdf8;
}
.fenix-term-history {
  margin-top: 16px;
  padding: 12px;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}
.fenix-term-history h5 {
  margin: 0 0 8px;
  font-size: 11px;
  font-weight: 700;
  color: #94a3b8;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}
.fenix-history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 4px 0;
  font-size: 11px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.03);
}
.fenix-history-item code {
  color: #e2e8f0;
  flex: 1;
  margin: 0 12px;
}
